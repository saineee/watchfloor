<mxfile host="app.diagrams.net">
  <diagram id="runtime" name="Runtime">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title, caption, legend -->
        <mxCell id="title" value="watchfloor: runtime architecture" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="120" y="10" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="caption" value="Shown in demo mode (enable_cloudfront = true). In test mode there is no CloudFront, and the ALB is open on port 80." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="120" y="45" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend_persist" value="Persistent root: survives terraform destroy" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;strokeColor=#ED7100;fillColor=#FFF4E8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1250" y="15" width="280" height="26" as="geometry" />
        </mxCell>
        <mxCell id="legend_app" value="Everything else: app stack, destroyed when idle" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1250" y="48" width="280" height="26" as="geometry" />
