        <mxCell id="e_prom_cm" value="DNS: api.watchfloor.local&lt;br&gt;(finds every API task)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#8C4FFF;" edge="1" parent="1" source="prom" target="cloudmap">
