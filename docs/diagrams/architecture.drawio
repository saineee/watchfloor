  <diagram id="cicd" name="CI/CD">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="c0" />
        <mxCell id="c1" parent="c0" />

        <mxCell id="c_title" value="watchfloor: CI/CD and who can change what" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="c1">
          <mxGeometry x="40" y="10" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c_caption" value="No AWS keys are stored in GitHub. Every job that touches AWS asks GitHub for a short-lived OIDC token, and AWS only trades it for credentials if aud = sts.amazonaws.com and sub matches the pattern pinned on that role. Each workflow gets its own role. terraform-bootstrap and terraform-persistent are applied by hand; CI only ever applies the terraform/ app stack." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#545B64;" vertex="1" parent="c1">
          <mxGeometry x="40" y="45" width="1180" height="50" as="geometry" />
        </mxCell>

        <!-- Column headers -->
        <mxCell id="h_t" value="Trigger" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#232F3E;" vertex="1" parent="c1">
          <mxGeometry x="40" y="110" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_w" value="Workflow (GitHub Actions)" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#232F3E;" vertex="1" parent="c1">
          <mxGeometry x="280" y="110" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_r" value="IAM role (OIDC sub it accepts)" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#232F3E;" vertex="1" parent="c1">
          <mxGeometry x="510" y="110" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_a" value="What it can touch" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#232F3E;" vertex="1" parent="c1">
          <mxGeometry x="840" y="110" width="380" height="30" as="geometry" />
        </mxCell>

        <!-- Bootstrap group behind the role column -->
        <mxCell id="g_boot" value="terraform-bootstrap: every CI role lives here, applied by hand, never by CI" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;strokeColor=#DD344C;fillColor=#FFF5F6;verticalAlign=bottom;align=center;fontSize=11;fontColor=#DD344C;" vertex="1" parent="c1">
          <mxGeometry x="500" y="160" width="300" height="935" as="geometry" />
        </mxCell>

        <!-- Row 1: backend-ci -->
        <mxCell id="r1_t" value="Pull request touching&lt;br&gt;backend/**" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="40" y="180" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r1_w" value="&lt;b&gt;backend-ci&lt;/b&gt;&lt;br&gt;pytest, 30 tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="280" y="180" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r1_r" value="no AWS role&lt;br&gt;(never touches AWS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;dashed=1;fontSize=11;fontColor=#545B64;" vertex="1" parent="c1">
          <mxGeometry x="510" y="180" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r1_a" value="runner only: a postgres:16 service container&lt;br&gt;(database watchfloordb_test)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#AAB7B8;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="840" y="180" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- Row 2: backend-cd -->
        <mxCell id="r2_t" value="Push a v* tag&lt;br&gt;(a release)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="40" y="280" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r2_w" value="&lt;b&gt;backend-cd&lt;/b&gt;&lt;br&gt;build once per tag,&lt;br&gt;migrate, then deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="280" y="280" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r2_r" value="&lt;b&gt;watchfloor-github-deploy&lt;/b&gt;&lt;br&gt;sub: ref:refs/tags/v*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8EA;strokeColor=#DD344C;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="510" y="280" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r2_a" value="ECR watchfloor-api: check tag, push (immutable)&lt;br&gt;ECS: register task def, run the migration task,&lt;br&gt;update watchfloor-service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="840" y="280" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- Row 3: frontend-ci -->
        <mxCell id="r3_t" value="Pull request touching&lt;br&gt;frontend/**" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="40" y="380" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r3_w" value="&lt;b&gt;frontend-ci&lt;/b&gt;&lt;br&gt;lint and build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="280" y="380" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r3_r" value="no AWS role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;dashed=1;fontSize=11;fontColor=#545B64;" vertex="1" parent="c1">
          <mxGeometry x="510" y="380" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r3_a" value="runner only: Node 22, npm ci, lint, build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#AAB7B8;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="840" y="380" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- Row 4: frontend-cd -->
        <mxCell id="r4_t" value="Merge to main touching&lt;br&gt;frontend/**, or manual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="40" y="480" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r4_w" value="&lt;b&gt;frontend-cd&lt;/b&gt;&lt;br&gt;build with VITE_API_URL=&quot;&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="280" y="480" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r4_r" value="&lt;b&gt;watchfloor-frontend-deploy&lt;/b&gt;&lt;br&gt;sub: ref:refs/heads/main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8EA;strokeColor=#DD344C;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="510" y="480" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r4_a" value="S3 frontend bucket: sync --delete&lt;br&gt;CloudFront: invalidate /*, only if a&lt;br&gt;distribution exists (skipped in test mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="840" y="480" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- Row 5: observability-ci -->
        <mxCell id="r5_t" value="Pull request touching&lt;br&gt;observability/prometheus/**&lt;br&gt;or the workflow itself" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="40" y="580" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r5_w" value="&lt;b&gt;observability-ci&lt;/b&gt;&lt;br&gt;promtool check + test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="280" y="580" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r5_r" value="no AWS role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;dashed=1;fontSize=11;fontColor=#545B64;" vertex="1" parent="c1">
          <mxGeometry x="510" y="580" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r5_a" value="runner only: docker run prom/prometheus:v3.14.0&lt;br&gt;(the same promtool version as production)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#AAB7B8;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="840" y="580" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- Row 6: observability-cd -->
        <mxCell id="r6_t" value="Merge to main touching&lt;br&gt;observability/**, or manual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="40" y="680" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r6_w" value="&lt;b&gt;observability-cd&lt;/b&gt;&lt;br&gt;git diff → build only&lt;br&gt;the changed images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="280" y="680" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r6_r" value="&lt;b&gt;watchfloor-github-obs-deploy&lt;/b&gt;&lt;br&gt;sub: ref:refs/heads/main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8EA;strokeColor=#DD344C;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="510" y="680" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r6_a" value="ECR watchfloor-obs-*: push only&lt;br&gt;(no deploy: the next terraform apply picks up&lt;br&gt;the newest image digest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="840" y="680" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- Row 7: terraform-plan -->
        <mxCell id="r7_t" value="Pull request touching&lt;br&gt;terraform/**" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="40" y="780" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r7_w" value="&lt;b&gt;terraform-plan&lt;/b&gt;&lt;br&gt;fmt, validate, plan&lt;br&gt;→ PR comment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="280" y="780" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r7_r" value="&lt;b&gt;watchfloor-read-only&lt;/b&gt;&lt;br&gt;sub: pull_request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8EA;strokeColor=#DD344C;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="510" y="780" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r7_a" value="read everything (ReadOnlyAccess)&lt;br&gt;write only the state lock file in the state bucket&lt;br&gt;(plan takes a lock, so it can't be fully read-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="840" y="780" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- Row 8: terraform-apply -->
        <mxCell id="r8_t" value="Manual run&lt;br&gt;checkbox: enable_cloudfront&lt;br&gt;(test or demo mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="40" y="880" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r8_w" value="&lt;b&gt;terraform-apply&lt;/b&gt;&lt;br&gt;environment: production&lt;br&gt;then runs migrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="280" y="880" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r8_r" value="&lt;b&gt;watchfloor-apply-role&lt;/b&gt;&lt;br&gt;sub: environment:production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8EA;strokeColor=#DD344C;strokeWidth=2;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="510" y="880" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r8_a" value="build the whole app stack (PowerUserAccess)&lt;br&gt;+ create watchfloor-ecs-* roles, but only with&lt;br&gt;the permissions boundary attached (see below)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="840" y="880" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- Row 9: terraform-destroy -->
        <mxCell id="r9_t" value="Manual run&lt;br&gt;type &quot;destroy&quot; to confirm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="40" y="980" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r9_w" value="&lt;b&gt;terraform-destroy&lt;/b&gt;&lt;br&gt;environment: production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="280" y="980" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r9_r" value="&lt;b&gt;watchfloor-apply-role&lt;/b&gt;&lt;br&gt;(same role as apply)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8EA;strokeColor=#DD344C;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="510" y="980" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r9_a" value="destroy the terraform/ app stack only&lt;br&gt;(persistent and bootstrap roots are untouched)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="840" y="980" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- Permissions boundary -->
        <mxCell id="boundary" value="&lt;b&gt;Permissions boundary: watchfloor-app-boundary&lt;/b&gt;&lt;br&gt;Every role the apply role creates must carry it. It caps those roles at: pulling images, reading SSM parameters, getting a web identity token, writing logs, publishing to watchfloor-* SNS topics, and the SSM tunnel channels.&lt;br&gt;No IAM writes and no assuming other roles. The apply role is explicitly denied from removing the boundary from a role or editing the boundary policy itself." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8EA;strokeColor=#DD344C;strokeWidth=2;dashed=1;fontSize=11;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="c1">
          <mxGeometry x="500" y="1130" width="720" height="110" as="geometry" />
        </mxCell>

        <!-- Row edges -->
        <mxCell id="e1a" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="c1" source="r1_t" target="r1_w"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1c" style="html=1;endArrow=block;endFill=1;strokeColor=#AAB7B8;dashed=1;" edge="1" parent="c1" source="r1_w" target="r1_a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2a" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="c1" source="r2_t" target="r2_w"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2b" value="OIDC" style="html=1;endArrow=block;endFill=1;strokeColor=#DD344C;fontSize=10;" edge="1" parent="c1" source="r2_w" target="r2_r"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2c" style="html=1;endArrow=block;endFill=1;strokeColor=#ED7100;" edge="1" parent="c1" source="r2_r" target="r2_a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3a" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="c1" source="r3_t" target="r3_w"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3c" style="html=1;endArrow=block;endFill=1;strokeColor=#AAB7B8;dashed=1;" edge="1" parent="c1" source="r3_w" target="r3_a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4a" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="c1" source="r4_t" target="r4_w"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4b" value="OIDC" style="html=1;endArrow=block;endFill=1;strokeColor=#DD344C;fontSize=10;" edge="1" parent="c1" source="r4_w" target="r4_r"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4c" style="html=1;endArrow=block;endFill=1;strokeColor=#ED7100;" edge="1" parent="c1" source="r4_r" target="r4_a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5a" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="c1" source="r5_t" target="r5_w"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5c" style="html=1;endArrow=block;endFill=1;strokeColor=#AAB7B8;dashed=1;" edge="1" parent="c1" source="r5_w" target="r5_a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6a" style="html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="c1" source="r6_t" target="r6_w"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6b" value="OIDC" style="html=1;endArrow=block;endFill=1;strokeColor=#DD344C;fontSize=10;" edge="1" parent="c1" source="r6_w" target="r6_r"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6c" style="html=1;endArrow=block;endFill=1;strokeColor=#ED7100;" edge="1" parent="c1" source="r6_r" target="r6_a"><mxGeometry relative="1" as="geometry" /></mxCell>
