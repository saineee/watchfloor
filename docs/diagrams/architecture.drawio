        <mxCell id="e_am_page" value="severity=page&lt;br&gt;sns:Publish (task role)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#E7157B;" edge="1" parent="1" source="am" target="sns_page">
