        <!-- API outbound -->
        <mxCell id="e_api_ssm" value="secrets injected at task start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#E7157B;dashed=1;exitX=0;exitY=0.5;entryX=0.1;entryY=0;" edge="1" parent="1" source="ssm" target="api">
